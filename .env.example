# ---- Web (apps/web) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # production: https://newsvio.in
SUPABASE_SECRET_KEY=                  # server only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                  # server only
RAZORPAY_WEBHOOK_SECRET=              # server only
RAZORPAY_LIVEMODE=false
PAYMENTS_MODE=razorpay                # 'free' = confirm at ₹0; 'link' = pay on PAYMENT_LINK_URL (razorpay.me), admin verifies
PAYMENT_LINK_URL=                     # e.g. https://razorpay.me/@yourhandle (PAYMENTS_MODE=link)
CHECKOUT_TOKEN_SECRET=                # server only, random 32+ bytes
CRON_SECRET=                          # server only, also stored in Supabase Vault as cron_secret
EMAIL_API_KEY=                        # server only
EMAIL_FROM="NewsVio <no-reply@newsvio.in>"   # domain must be verified with the email provider

# ---- Edge Functions (supabase/functions) ----
SITE_URL=http://localhost:3000        # links in emails; production: https://newsvio.in
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash           # optional overrides (free-tier model names change)
GEMINI_LITE_MODEL=gemini-3.5-flash-lite  # OCR
GEMINI_DAILY_QUOTA=200
GEMINI_SEARCH=off                        # 'on' needs Gemini billing: Search grounding isn't in the free tier
GOOGLE_FACTCHECK_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
SEARXNG_URL=                          # e.g. http://host.docker.internal:8888 (infra/searxng)
SEARXNG_SECRET=                       # only for infra/searxng/docker-compose.yml
EXPO_ACCESS_TOKEN=

# ---- Mobile (apps/mobile) ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000   # production builds: https://newsvio.in
EXPO_PUBLIC_PAYMENTS_MODE=razorpay    # labels only; must match PAYMENTS_MODE
EXPO_PUBLIC_PAYMENT_LINK_URL=         # same as PAYMENT_LINK_URL
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ---- Local Supabase Google sign-in (Web client first, then native clients, comma-separated) ----
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Legacy Supabase key fallbacks (normally leave blank for new hosted projects)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only
