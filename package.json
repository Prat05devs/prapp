{
  "name": "prapp",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=mobile",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:sql": "bash scripts/test-sql-docker.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/db-types/src/database.ts && prettier --write packages/db-types/src/database.ts",
    "test:integration": "pnpm --filter web test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "supabase": "^2",
    "turbo": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
